  fi [shape=box, style="rounded,filled", fillcolor="#1E6B3A", fontcolor="white", label="final"];
  null [shape=plaintext, label="NULL", fontcolor="#C0392B", fontsize=14];
  node [shape=plaintext];
  c1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#E3F4E1" COLOR="#1E6B3A"><TR><TD BGCOLOR="#1E6B3A"><FONT COLOR="white"><B>PID 100</B></FONT></TD><TD ROWSPAN="2" PORT="s" BGCOLOR="#C9E8C4">sig<BR/>&#9679;</TD></TR><TR><TD>prioridad 1</TD></TR></TABLE>>];
  c2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#E3F4E1" COLOR="#1E6B3A"><TR><TD BGCOLOR="#1E6B3A"><FONT COLOR="white"><B>PID 102</B></FONT></TD><TD ROWSPAN="2" PORT="s" BGCOLOR="#C9E8C4">sig<BR/>&#9679;</TD></TR><TR><TD>prioridad 2</TD></TR></TABLE>>];
  c3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#E3F4E1" COLOR="#1E6B3A"><TR><TD BGCOLOR="#1E6B3A"><FONT COLOR="white"><B>PID 101</B></FONT></TD><TD ROWSPAN="2" PORT="s" BGCOLOR="#C9E8C4">sig<BR/>&#9679;</TD></TR><TR><TD>prioridad 3</TD></TR></TABLE>>];
  c4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#E3F4E1" COLOR="#1E6B3A"><TR><TD BGCOLOR="#1E6B3A"><FONT COLOR="white"><B>PID 103</B></FONT></TD><TD ROWSPAN="2" PORT="s" BGCOLOR="#C9E8C4">sig<BR/>&#9679;</TD></TR><TR><TD>prioridad 5</TD></TR></TABLE>>];
  fr -> c1; c1:s -> c2; c2:s -> c3; c3:s -> c4; c4:s -> null;
