digraph G { 
  bgcolor="white"; nodesep=0.35; ranksep=0.32; splines=ortho;
  node [fontname="Liberation Sans", fontsize=12, penwidth=1.3, color="#1F3A5F", style=filled, fillcolor="#DCEBFA", shape=box, margin="0.15,0.06"];
  edge [fontname="Liberation Sans", fontsize=11, color="#1F3A5F", penwidth=1.2, arrowsize=0.7];

  ini [label="INICIO", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white"];
  a1 [label="cabeza ← NULL, frente ← NULL\nfin ← NULL, tope ← NULL"];
  a2 [label="cargarDatos()\n(procesos.txt, memoria.txt)"];
  a3 [label="Mostrar menú principal", shape=parallelogram, fillcolor="#FFFFFF"];
  a4 [label="opcion ← leerNumero()", shape=parallelogram, fillcolor="#FFFFFF"];
  d1 [label="switch (opcion)", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  m1 [label="1. Gestor de procesos\n(lista enlazada)"];
  m2 [label="2. Planificador CPU\n(cola de prioridad)", fillcolor="#E3F4E1", color="#1E6B3A"];
  m3 [label="3. Gestor de memoria\n(pila)", fillcolor="#FDEBD3", color="#B5651D"];
  m4 [label="4. Guardar datos\n5. Datos de ejemplo", fillcolor="#FFFFFF"];
  d2 [label="¿opcion == 0?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a5 [label="guardarDatos()\nliberarTodo()"];
  final [label="FIN", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white"];
  ini -> a1 -> a2 -> a3 -> a4 -> d1;
  d1 -> m1; d1 -> m2; d1 -> m3; d1 -> m4;
  m1 -> d2; m2 -> d2; m3 -> d2; m4 -> d2; d1 -> d2 [xlabel="0"];
  d2 -> a3 [xlabel="No"]; d2 -> a5 [xlabel="Sí"]; a5 -> final;
}
