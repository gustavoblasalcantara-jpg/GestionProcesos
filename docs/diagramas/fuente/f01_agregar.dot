digraph G { 
  bgcolor="white"; nodesep=0.35; ranksep=0.32; splines=ortho;
  node [fontname="Liberation Sans", fontsize=12, penwidth=1.3, color="#1F3A5F", style=filled, fillcolor="#DCEBFA", shape=box, margin="0.15,0.06"];
  edge [fontname="Liberation Sans", fontsize=11, color="#1F3A5F", penwidth=1.2, arrowsize=0.7];

  ini [label="INICIO", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white"];
  a1 [label="Leer ID (leerNumero)", shape=parallelogram, fillcolor="#FFFFFF"];
  d0 [label="¿id ≤ 0 o ya existe\n(buscarProceso)?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e0 [label="Mostrar error\ny volver al menú", fillcolor="#FBE3E1", color="#C0392B"];
  a2 [label="Leer nombre", shape=parallelogram, fillcolor="#FFFFFF"];
  d1 [label="¿nombre vacío?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e1 [label="Mostrar error\ny volver al menú", fillcolor="#FBE3E1", color="#C0392B"];
  a3 [label="Leer prioridad", shape=parallelogram, fillcolor="#FFFFFF"];
  d2 [label="¿1 ≤ prioridad ≤ 5?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e2 [label="Mostrar error\ny volver al menú", fillcolor="#FBE3E1", color="#C0392B"];
  a4 [label="Leer ráfaga", shape=parallelogram, fillcolor="#FFFFFF"];
  d3 [label="¿1 ≤ ráfaga ≤ 50?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e3 [label="Mostrar error\ny volver al menú", fillcolor="#FBE3E1", color="#C0392B"];
  a5 [label="nuevo ← new Proceso\n(id, nombre, prioridad,\nráfaga, \"NUEVO\", siguiente = NULL)"];
  d4 [label="¿cabeza == NULL?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a6 [label="cabeza ← nuevo"];
  a7 [label="aux ← cabeza"];
  d5 [label="¿aux→siguiente\n≠ NULL?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a8 [label="aux ← aux→siguiente"];
  a9 [label="aux→siguiente ← nuevo"];
  a10 [label="mensajeExito(\"Proceso registrado\")"];
  d6 [label="¿Respuesta == 1?\n(enviar a la cola)", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a11 [label="cambiarEstado(p, \"LISTO\")\n→ encolar por prioridad"];
  final [label="FIN", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white"];
  ini -> a1 -> d0; d0 -> e0 [xlabel="Sí"]; d0 -> a2 [xlabel="No"]; e0 -> final; a2 -> d1;
  d1 -> e1 [xlabel="Sí"]; e1 -> final;
  d1 -> a3 [xlabel="No"]; a3 -> d2;
  d2 -> e2 [xlabel="No"]; e2 -> final;
  d2 -> a4 [xlabel="Sí"]; a4 -> d3;
  d3 -> e3 [xlabel="No"]; e3 -> final;
  d3 -> a5 [xlabel="Sí"]; a5 -> d4;
  d4 -> a6 [xlabel="Sí"]; d4 -> a7 [xlabel="No"];
  a7 -> d5; d5 -> a8 [xlabel="Sí"]; a8 -> d5;
  d5 -> a9 [xlabel="No"];
  a6 -> a10; a9 -> a10; a10 -> d6;
  d6 -> a11 [xlabel="Sí"]; d6 -> final [xlabel="No"]; a11 -> final;
  {rank=same; d0; e0;} {rank=same; d1; e1;} {rank=same; d2; e2;} {rank=same; d3; e3;} {rank=same; d5; a8;}
}
