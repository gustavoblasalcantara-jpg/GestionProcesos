digraph G { 
  bgcolor="white"; nodesep=0.35; ranksep=0.32; splines=ortho;
  node [fontname="Liberation Sans", fontsize=12, penwidth=1.3, color="#1F3A5F", style=filled, fillcolor="#DCEBFA", shape=box, margin="0.15,0.06"];
  edge [fontname="Liberation Sans", fontsize=11, color="#1F3A5F", penwidth=1.2, arrowsize=0.7];

  ini [label="INICIO", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white"];
  a1 [label="Leer ID", shape=parallelogram, fillcolor="#FFFFFF"];
  a2 [label="p ← buscarProceso(cabeza, id)"];
  d1 [label="¿p == NULL?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e1 [label="\"No existe el proceso\"", fillcolor="#FBE3E1", color="#C0392B"];
  d2 [label="¿p→estado ==\nTERMINADO?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e2 [label="\"Ya está TERMINADO\"", fillcolor="#FBE3E1", color="#C0392B"];
  a3 [label="Leer nuevo estado", shape=parallelogram, fillcolor="#FFFFFF"];
  d3 [label="¿transicionValida\n(actual, nuevo)?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  e3 [label="\"Transición no permitida\"", fillcolor="#FBE3E1", color="#C0392B"];
  d4 [label="¿aux == LISTO?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a4 [label="quitarDeCola(frente, final, id)"];
  d5 [label="¿nuevo == LISTO?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a5 [label="encolar(frente, final, ...)\nsegún prioridad"];
  d6 [label="¿nuevo ==\nTERMINADO?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a6 [label="liberarMemoriaDeProceso(tope, id)\n(pila auxiliar)"];
  a7 [label="p→estado ← nuevo"];
  a8 [label="Mostrar \"aux → nuevo\"", shape=parallelogram, fillcolor="#FFFFFF"];
  final [label="FIN", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white"];
  ini -> a1 -> a2 -> d1;
  d1 -> e1 [xlabel="Sí"]; d1 -> d2 [xlabel="No"];
  d2 -> e2 [xlabel="Sí"]; d2 -> a3 [xlabel="No"];
  a3 -> d3; d3 -> e3 [xlabel="No"]; d3 -> d4 [xlabel="Sí"];
  d4 -> a4 [xlabel="Sí"]; d4 -> d5 [xlabel="No"]; a4 -> d5;
  d5 -> a5 [xlabel="Sí"]; d5 -> d6 [xlabel="No"]; a5 -> d6;
  d6 -> a6 [xlabel="Sí"]; d6 -> a7 [xlabel="No"]; a6 -> a7;
  a7 -> a8 -> final;
  e1 -> final; e2 -> final; e3 -> final;
  {rank=same; d1; e1;} {rank=same; d2; e2;} {rank=same; d3; e3;} {rank=same; d4; a4;} {rank=same; d5; a5;} {rank=same; d6; a6;}
}
