digraph G { 
  bgcolor="white"; nodesep=0.35; ranksep=0.32; splines=ortho;
  node [fontname="Liberation Sans", fontsize=12, penwidth=1.3, color="#1F3A5F", style=filled, fillcolor="#DCEBFA", shape=box, margin="0.15,0.06"];
  edge [fontname="Liberation Sans", fontsize=11, color="#1F3A5F", penwidth=1.2, arrowsize=0.7];

  node [fillcolor="#FDEBD3", color="#B5651D"]; edge [color="#B5651D"];
  ini [label="INICIO  liberarMemoriaDeProceso(tope, id)", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white", fillcolor="#B5651D"];
  a1 [label="auxiliar ← NULL (pila vacía)\nliberado ← 0"];
  d1 [label="¿pop(tope) obtuvo\nun bloque?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  d2 [label="¿bloque.idProceso == id?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a2 [label="liberado ← liberado\n+ bloque.tamaño"];
  a3 [label="push(auxiliar, bloque)"];
  d3 [label="¿pop(auxiliar)\nobtuvo un bloque?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
  a4 [label="push(tope, bloque)"];
  a5 [label="Retornar liberado", shape=parallelogram, fillcolor="#FFFFFF"];
  final [label="FIN", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white", fillcolor="#B5651D"];
  ini -> a1 -> d1; d1 -> d2 [xlabel="Sí"]; d2 -> a2 [xlabel="Sí"]; d2 -> a3 [xlabel="No"];
  a2 -> d1; a3 -> d1;
  d1 -> d3 [xlabel="No"]; d3 -> a4 [xlabel="Sí"]; a4 -> d3; d3 -> a5 [xlabel="No"]; a5 -> final;
  {rank=same; d3; a4;}
}
