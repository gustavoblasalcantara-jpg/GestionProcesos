digraph G {
  rankdir=LR; bgcolor="white"; nodesep=0.5; ranksep=0.4;
  node [fontname="Liberation Sans", fontsize=13];
  edge [color="#1E6B3A", penwidth=1.5, arrowsize=0.8];
