digraph G {
  rankdir=LR; bgcolor="white"; nodesep=0.9; ranksep=0.9;
  node [fontname="Liberation Sans", fontsize=13, shape=circle, style=filled, width=1.3, fixedsize=true, color="#1F3A5F", penwidth=1.5];
  edge [fontname="Liberation Sans", fontsize=11, color="#1F3A5F", fontcolor="#222222", penwidth=1.4];
  NUEVO [fillcolor="#E8EEF6"]; LISTO [fillcolor="#E3F4E1"]; EJECUCION [label="EJECUCIÓN", fillcolor="#FFF4CC", fontsize=12];
  BLOQUEADO [fillcolor="#FBE3E1", fontsize=12]; TERMINADO [fillcolor="#D9D9D9", fontsize=12];
  NUEVO -> LISTO [label="encolar"];
  LISTO -> EJECUCION [label="desencolar\n(despachar CPU)"];
  EJECUCION -> TERMINADO [label="fin de ráfaga\n(libera memoria)"];
  LISTO -> BLOQUEADO [label="bloquear\n(sale de la cola)"];
  BLOQUEADO -> LISTO [label="desbloquear\n(vuelve a la cola)"];
  edge [style=dashed, color="#888888"];
  NUEVO -> TERMINADO [constraint=false]; BLOQUEADO -> TERMINADO; LISTO -> TERMINADO [constraint=false];
  {rank=same; EJECUCION; BLOQUEADO;}
  ley [shape=plaintext, style="", fixedsize=false, fontsize=11, fontcolor="#555555", label="- - -  finalizar manualmente (libera memoria)"];
  {rank=same; NUEVO; ley;}
}
