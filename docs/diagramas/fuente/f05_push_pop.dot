digraph G { 
  bgcolor="white"; nodesep=0.35; ranksep=0.32; splines=ortho;
  node [fontname="Liberation Sans", fontsize=12, penwidth=1.3, color="#1F3A5F", style=filled, fillcolor="#DCEBFA", shape=box, margin="0.15,0.06"];
  edge [fontname="Liberation Sans", fontsize=11, color="#1F3A5F", penwidth=1.2, arrowsize=0.7];

  node [fillcolor="#FDEBD3", color="#B5651D"]; edge [color="#B5651D"];
  subgraph cluster_push { label="PUSH  (asignar memoria)"; fontname="Liberation Sans Bold"; fontsize=13; color="#B5651D"; style="rounded,dashed";
    pi [label="INICIO", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white", fillcolor="#B5651D"];
    p1 [label="Leer ID", shape=parallelogram, fillcolor="#FFFFFF"];
    pd1 [label="¿existe y no está\nTERMINADO?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
    pe1 [label="Mostrar error", fillcolor="#FBE3E1", color="#C0392B"];
    p2 [label="Leer tamaño", shape=parallelogram, fillcolor="#FFFFFF"];
    pd2 [label="¿0 < tamaño ≤\nmemoria libre?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
    pe2 [label="Mostrar error", fillcolor="#FBE3E1", color="#C0392B"];
    p3 [label="nuevo→siguiente ← tope\ntope ← nuevo"];
    pf [label="FIN", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white", fillcolor="#B5651D"];
    pi -> p1 -> pd1; pd1 -> pe1 [xlabel="No"]; pd1 -> p2 [xlabel="Sí"];
    p2 -> pd2; pd2 -> pe2 [xlabel="No"]; pe2 -> pf; pd2 -> p3 [xlabel="Sí"]; p3 -> pf; pe1 -> pf;
    {rank=same; pd1; pe1;} {rank=same; pd2; pe2;}
  }
  subgraph cluster_pop { label="POP  (liberar memoria)"; fontname="Liberation Sans Bold"; fontsize=13; color="#B5651D"; style="rounded,dashed";
    qi [label="INICIO", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white", fillcolor="#B5651D"];
    qd1 [label="¿tope == NULL?", shape=diamond, fillcolor="#FFF4CC", color="#B8860B", fontsize=11];
    qe1 [label="\"Pila vacía\"\n(underflow)", fillcolor="#FBE3E1", color="#C0392B"];
    q1 [label="temp ← tope\ntope ← temp→siguiente"];
    q2 [label="delete temp"];
    q3 [label="Mostrar bloque liberado", shape=parallelogram, fillcolor="#FFFFFF"];
    qf [label="FIN", shape=box, style="rounded,filled", fillcolor="#1F3A5F", fontcolor="white", fillcolor="#B5651D"];
    qi -> qd1; qd1 -> qe1 [xlabel="Sí"]; qd1 -> q1 [xlabel="No"]; q1 -> q2 -> q3 -> qf; qe1 -> qf;
    {rank=same; qd1; qe1;}
  }
}
